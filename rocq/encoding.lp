// symbols used for encoding simple type theory

builtin "Set" ≔ Set;
builtin "El" ≔ {|τ|};
builtin "arr" ≔ {|⤳|};
builtin "prop" ≔ Prop;
builtin "Prf" ≔ {|π|};
builtin "imp" ≔ {|⇒|};
builtin "not" ≔ {|¬|};
builtin "or" ≔ {|∨|};
builtin "and" ≔ {|∧|};
builtin "eq" ≔ =;
builtin "all" ≔ {|∀|};
builtin "ex" ≔ {|∃|};
